[Unit]
Description=Wirebound game (static file server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wirebound
Environment=HOST=127.0.0.1
Environment=PORT=5177
ExecStart=/usr/bin/node /opt/wirebound/server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
