[Unit]
Description=Caddy for Wirebound
After=network.target

[Service]
User=www-data
Group=www-data
EnvironmentFile=/opt/wirebound/deploy/config.env
ExecStart=/usr/bin/caddy run --config /opt/wirebound/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
